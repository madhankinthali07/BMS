# CineAlert Configuration File
# Rename this file to .env and configure your values

# App Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database Configuration (Defaults to SQLite in project folder)
DATABASE_URL=sqlite:///./cinealert.db

# Email / SMTP Configuration (For Real-Time Notifications)
# For Gmail: Use an App Password (not your normal Gmail password)
# Guide: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SENDER_EMAIL=your_email@gmail.com
SENDER_NAME=CineAlert Bot

# Monitoring Intervals (in seconds)
DEFAULT_CHECK_INTERVAL=120
MIN_CHECK_INTERVAL=30
